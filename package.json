{
  "name": "voice-engineering",
  "private": true,
  "version": "0.0.0",
  "description": "Interactive voice security training modules for Call Center Village",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallCenterVillage/voice-training.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:security && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "pnpm run build:security && vite build",
    "build:security": "node scripts/build-security-txt.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wavesurfer.js": "^7.12.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/deno": "^2.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
